# Urban Parcel Intelligence — environment template
# Copy to .env and adjust. No secrets are required for the demonstration build.

# --- Demonstration location (client) ---
# VITE_DEMO_LOCATION="T. Nagar, Chennai, Tamil Nadu, India"
# VITE_DEMO_CITY=Chennai
# VITE_DEMO_STATE="Tamil Nadu"
# VITE_DEMO_LAT=13.0418
# VITE_DEMO_LON=80.2341
# VITE_DEMO_ZOOM=16.2

# The data generator (scripts/generate-demo-parcels.mjs) reads the un-prefixed
# equivalents so the parcels are placed at the same spot:
#   DEMO_LAT DEMO_LON DEMO_CITY DEMO_STATE DEMO_LOCALITY

# --- Base map tiles (both keyless; override if you have a provider) ---
# VITE_BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# --- Real-time loop cadence (ms) ---
# VITE_SYNC_INTERVAL_MS=8000

# --- Simulation backend (server/) ---
# Port the Node simulation server listens on (dev proxy + prod static host).
# SIM_PORT=8787
# Base path the frontend uses for the simulation API. Default "/api" works
# with the Vite dev proxy and when the Node server serves the built app.
# VITE_SIM_API=/api
