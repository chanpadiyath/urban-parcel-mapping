# Urban Parcel Intelligence — frontend environment template (Vite `VITE_*` vars only).
# Copy to .env.local and adjust. No secrets belong here — anything VITE_* is
# bundled into the browser. Backend secrets (e.g. GOOGLE_MAPS_API_KEY) live in
# backend/.env, see ../backend/.env.example.

# --- Demonstration location ---
# VITE_DEMO_LOCATION="T. Nagar, Chennai, Tamil Nadu, India"
# VITE_DEMO_CITY=Chennai
# VITE_DEMO_STATE="Tamil Nadu"
# VITE_DEMO_LAT=13.0418
# VITE_DEMO_LON=80.2341
# VITE_DEMO_ZOOM=16.2

# --- Base map tiles (both keyless; override if you have a provider) ---
# VITE_BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# --- Real-time loop cadence (ms) ---
# VITE_SYNC_INTERVAL_MS=8000

# --- Backend API ---
# Base URL the app calls. The default "/api" works in dev (Vite proxies it to
# the backend on localhost:8787 — edit vite.config.ts if you run it elsewhere).
# For a separate production deployment set the backend's full URL, e.g.
# https://api.example.com/api, and add this site's origin to the backend's
# CORS_ORIGINS.
# VITE_SIM_API=/api
