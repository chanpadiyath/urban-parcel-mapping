# Urban Parcel Intelligence — backend environment template.
# Copy to backend/.env (gitignored). Every value is optional.

# Port the API listens on (the frontend dev proxy expects 8787).
# SIM_PORT=8787

# Site whose committed elevation snapshot (data/elevation-<site>.json) the
# flood simulation runs over.
# SIM_SITE=chennai

# Origins allowed to call the API from a browser (comma-separated). Add your
# deployed frontend's origin here when hosting the two separately.
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Skip the startup live refresh from Overpass (offline dev). Default: refresh.
# OSM_LIVE_REFRESH=0

# --- Google Maps Platform (optional) ---
# Only needed for address-search fallback + "Nearby (Google Places)" parcel
# enrichment. Requires your own Google Cloud project with billing and the
# "Geocoding API" + "Places API (New)" enabled. Server-side only — never sent
# to the browser. Without it those two features report "unavailable".
# GOOGLE_MAPS_API_KEY=

# --- Demo data generator (python -m jobs.generate_demo_parcels) ---
# DEMO_LAT=13.0418
# DEMO_LON=80.2341
# DEMO_CITY=Chennai
# DEMO_STATE="Tamil Nadu"
# DEMO_LOCALITY="T. Nagar"
