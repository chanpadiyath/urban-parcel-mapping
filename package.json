{
  "name": "urban-parcel-mapping",
  "private": true,
  "version": "0.2.0",
  "description": "Urban Parcel Intelligence — monorepo: frontend (TypeScript/React/MapLibre) + backend (Python/FastAPI)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "node scripts/api.mjs",
    "build": "npm --prefix frontend run build",
    "test": "node scripts/api.mjs test",
    "gen:data": "node scripts/api.mjs job generate_demo_parcels",
    "gen:elevation": "node scripts/api.mjs job fetch_elevation"
  }
}
